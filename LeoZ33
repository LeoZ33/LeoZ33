<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Leo's Game Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --neon-green: #00eaff;
    --neon-blue: #00eaff;
    --neon-pink: #ff2d78;
    --neon-yellow: #ffe600;
    --dark: #0a0a12;
    --dark2: #12121e;
    --dark3: #1a1a2e;
    --card-bg: #13132a;
    --text: #e0e0f0;
    --muted: #7a7a9a;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: var(--dark);
    color: var(--text);
    font-family: 'Rajdhani', sans-serif;
    font-size: 17px;
    line-height: 1.6;
    overflow-x: hidden;
  }
  body::before {
    content: '';
    position: fixed; inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0px, transparent 3px, rgba(0,0,0,0.08) 3px, rgba(0,0,0,0.08) 4px);
    pointer-events: none; z-index: 999;
  }
  body::after {
    content: '';
    position: fixed; inset: 0;
    background-image: linear-gradient(rgba(57,255,20,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(57,255,20,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none; z-index: 0;
  }
  .container { max-width: 960px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }
  nav {
    border-bottom: 1px solid rgba(57,255,20,0.2);
    padding: 18px 0; position: sticky; top: 0;
    background: rgba(10,10,18,0.92); backdrop-filter: blur(8px); z-index: 100;
  }
  nav .inner { max-width: 960px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; }
  .logo { font-family: 'Press Start 2P', monospace; font-size: 12px; color: var(--neon-green); text-shadow: 0 0 12px var(--neon-green); letter-spacing: 2px; }
  nav ul { list-style: none; display: flex; gap: 28px; }
  nav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 15px; letter-spacing: 1px; text-transform: uppercase; transition: color 0.2s; }
  nav a:hover { color: var(--neon-blue); }
  .hero { padding: 90px 0 70px; text-align: center; }
  .hero-tag { display: inline-block; font-family: 'Press Start 2P', monospace; font-size: 9px; color: #39ff14; border: 1px solid #39ff14; padding: 6px 14px; margin-bottom: 28px; letter-spacing: 2px; text-shadow: 0 0 8px #39ff14; }
  .hero h1 { font-family: 'Press Start 2P', monospace; font-size: clamp(22px, 5vw, 42px); line-height: 1.5; color: #fff; margin-bottom: 14px; text-shadow: 0 0 30px rgba(57,255,20,0.4); }
  .hero h1 span { color: var(--neon-green); }
  .hero-sub { font-size: 20px; color: var(--muted); margin-bottom: 10px; font-weight: 600; letter-spacing: 1px; }
  .hero-grade { font-family: 'Press Start 2P', monospace; font-size: 10px; color: var(--neon-blue); text-shadow: 0 0 8px var(--neon-blue); margin-bottom: 36px; }
  .hero-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 12px 28px; font-family: 'Press Start 2P', monospace; font-size: 9px; text-decoration: none; letter-spacing: 1px; border: 2px solid; cursor: pointer; transition: all 0.2s; }
  .btn-primary { background: var(--neon-green); color: var(--dark); border-color: var(--neon-green); box-shadow: 0 0 18px rgba(57,255,20,0.4); }
  .btn-primary:hover { box-shadow: 0 0 32px rgba(57,255,20,0.7); transform: translateY(-2px); }
  .btn-outline { background: transparent; color: var(--neon-blue); border-color: var(--neon-blue); }
  .btn-outline:hover { background: rgba(0,234,255,0.1); transform: translateY(-2px); }
  .avatar-wrap { width: 120px; height: 120px; margin: 0 auto 30px; position: relative; }
  .avatar-ring { position: absolute; inset: -8px; border-radius: 50%; border: 2px solid var(--neon-green); box-shadow: 0 0 20px rgba(57,255,20,0.5); animation: spinRing 8s linear infinite; }
  @keyframes spinRing { to { transform: rotate(360deg); } }
  .avatar-inner { width: 100%; height: 100%; border-radius: 50%; background: var(--dark3); display: flex; align-items: center; justify-content: center; font-family: 'Press Start 2P', monospace; font-size: 36px; color: var(--neon-green); text-shadow: 0 0 16px var(--neon-green); border: 2px solid rgba(57,255,20,0.3); overflow: hidden; }
  section { padding: 70px 0; }
  .section-label { font-family: 'Press Start 2P', monospace; font-size: 8px; color: #39ff14; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 10px; }
  .section-title { font-family: 'Press Start 2P', monospace; font-size: clamp(14px, 3vw, 22px); color: #fff; margin-bottom: 40px; text-shadow: 0 0 20px rgba(0,234,255,0.3); }
  .divider { height: 1px; background: linear-gradient(90deg, transparent, var(--neon-green), transparent); margin-bottom: 60px; opacity: 0.3; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 60px; }
  .stat-card { background: var(--card-bg); border: 1px solid rgba(57,255,20,0.15); padding: 24px 20px; text-align: center; position: relative; overflow: hidden; transition: border-color 0.3s; }
  .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--neon-green); box-shadow: 0 0 10px var(--neon-green); }
  .stat-card:hover { border-color: rgba(57,255,20,0.5); }
  .stat-number { font-family: 'Press Start 2P', monospace; font-size: 24px; color: var(--neon-green); text-shadow: 0 0 14px var(--neon-green); display: block; margin-bottom: 8px; }
  .stat-label { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
  /* FEATURED GAME */
  .featured-game { display: grid; grid-template-columns: 1fr; border: 2px solid rgba(57,255,20,0.5); background: var(--card-bg); overflow: hidden; box-shadow: 0 0 40px rgba(57,255,20,0.12); margin-bottom: 20px; }
  .featured-screenshots { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .featured-screenshots img { width: 100%; height: 200px; object-fit: cover; display: block; }
  .featured-screenshots img:first-child { border-right: 2px solid rgba(57,255,20,0.3); }
  .featured-body { padding: 28px; }
  .featured-tag { font-family: 'Press Start 2P', monospace; font-size: 7px; color: var(--neon-yellow); border: 1px solid rgba(255,230,0,0.3); padding: 4px 10px; letter-spacing: 1px; }
  .featured-title { font-family: 'Press Start 2P', monospace; font-size: clamp(14px, 3vw, 20px); color: #fff; margin-bottom: 10px; line-height: 1.5; text-shadow: 0 0 20px rgba(57,255,20,0.4); }
  .featured-desc { font-size: 15px; color: var(--muted); line-height: 1.6; }
  .game-badge { display: inline-block; font-family: 'Press Start 2P', monospace; font-size: 7px; padding: 4px 10px; margin-bottom: 10px; letter-spacing: 1px; }
  .badge-roblox { background: rgba(255,45,120,0.15); color: var(--neon-pink); border: 1px solid rgba(255,45,120,0.3); }
  .games-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 20px; }
  .game-card { background: var(--card-bg); border: 1px solid rgba(0,234,255,0.15); overflow: hidden; position: relative; transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s; cursor: pointer; }
  .game-card:hover { transform: translateY(-6px); border-color: rgba(0,234,255,0.5); box-shadow: 0 12px 40px rgba(0,234,255,0.1); }
  .game-thumb { height: 140px; display: flex; align-items: center; justify-content: center; font-size: 52px; position: relative; overflow: hidden; }
  .game-thumb::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, var(--card-bg)); }
  .game-body { padding: 18px 20px 20px; }
  .game-title { font-family: 'Press Start 2P', monospace; font-size: 11px; color: #fff; margin-bottom: 8px; line-height: 1.6; }
  .game-desc { font-size: 14px; color: var(--muted); line-height: 1.5; margin-bottom: 14px; }
  .game-meta { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 12px; }
  .stars { color: var(--neon-yellow); font-size: 13px; }
  .game-year { font-family: 'Press Start 2P', monospace; font-size: 7px; color: var(--muted); }
  /* SKILLS */
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .skill-item { background: var(--card-bg); border: 1px solid rgba(255,255,255,0.07); padding: 20px; transition: border-color 0.3s; }
  .skill-item:hover { border-color: rgba(57,255,20,0.3); }
  .skill-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .skill-name { font-weight: 700; font-size: 16px; letter-spacing: 0.5px; }
  .skill-lvl { font-family: 'Press Start 2P', monospace; font-size: 7px; color: var(--neon-green); }
  .skill-bar { height: 5px; background: rgba(255,255,255,0.08); border-radius: 2px; overflow: hidden; }
  .skill-fill { height: 100%; background: linear-gradient(90deg, var(--neon-green), var(--neon-blue)); box-shadow: 0 0 8px rgba(57,255,20,0.5); border-radius: 2px; }
  .skill-icon { font-size: 22px; margin-bottom: 8px; }
  /* ABOUT */
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: start; }
  @media (max-width: 620px) {
    .about-grid { grid-template-columns: 1fr; }
    nav ul { gap: 14px; }
    .hero h1 { font-size: 18px; }
    .featured-screenshots { grid-template-columns: 1fr; }
    .featured-screenshots img:first-child { border-right: none; border-bottom: 2px solid rgba(255,45,120,0.3); }
  }
  .about-text p { color: var(--muted); line-height: 1.8; margin-bottom: 14px; font-size: 16px; }
  .about-text p strong { color: var(--neon-green); font-weight: 700; }
  .about-info { background: var(--card-bg); border: 1px solid rgba(255,230,0,0.15); padding: 24px; }
  .info-row { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 15px; }
  .info-row:last-child { border-bottom: none; }
  .info-key { font-family: 'Press Start 2P', monospace; font-size: 7px; color: var(--neon-yellow); min-width: 80px; padding-top: 4px; letter-spacing: 1px; }
  .info-val { color: var(--text); font-weight: 600; }
  /* CONTACT */
  .contact-box { text-align: center; background: var(--card-bg); border: 1px solid rgba(57,255,20,0.2); padding: 48px 32px; position: relative; overflow: hidden; }
  .contact-box::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(57,255,20,0.05) 0%, transparent 70%); }
  .contact-box h3 { font-family: 'Press Start 2P', monospace; font-size: 14px; color: #fff; margin-bottom: 14px; }
  .contact-box p { color: var(--muted); margin-bottom: 28px; font-size: 16px; }
  .contact-links { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .contact-chip { display: inline-flex; align-items: center; gap: 8px; background: var(--dark3); border: 1px solid rgba(0,234,255,0.25); padding: 10px 20px; color: var(--neon-blue); font-weight: 700; font-size: 14px; letter-spacing: 1px; text-decoration: none; transition: all 0.2s; }
  .contact-chip:hover { background: rgba(0,234,255,0.08); border-color: var(--neon-blue); }
  footer { border-top: 1px solid rgba(57,255,20,0.1); padding: 30px 0; text-align: center; }
  footer p { font-family: 'Press Start 2P', monospace; font-size: 7px; color: var(--muted); letter-spacing: 2px; }
  footer span { color: var(--neon-pink); }
  .blink { display: inline-block; width: 10px; height: 18px; background: var(--neon-green); margin-left: 4px; vertical-align: middle; animation: blink 1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.6s, transform 0.6s; }
  .fade-in.visible { opacity: 1; transform: none; }
</style>
</head>
